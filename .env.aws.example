# =============================================================================
# Poysis AI Worker — AWS environment variables
# =============================================================================
# Copy this file to .env for local development against RDS.
# On ECS, all secrets below are injected from AWS Secrets Manager (poysis/app
# and poysis/rds). Non-secret config is set directly in the task definition.
# =============================================================================

# ── Database (RDS PostgreSQL) ─────────────────────────────────────────────────
# On ECS these are injected from the poysis/rds Secrets Manager secret.
# For local dev, build the connection string manually:
#   postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DB_HOST=your-rds-instance.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=poysis
DB_USER=poysis
DB_PASSWORD=REPLACE_ME
DB_SSLMODE=require
# Convenience full DSN for scripts/migrate_db.py and local testing:
DB_CONNECTION_STRING=postgresql://poysis:REPLACE_ME@your-rds-instance.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/poysis

# Local dev only — keep Supabase connection as fallback:
# SUPABASE_DIRECT_CONNECTION_STRING=postgresql://...

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_DEFAULT_REGION=us-east-1
# AWS_BEDROCK_REGION defaults to AWS_DEFAULT_REGION if not set
AWS_BEDROCK_REGION=us-east-1
# On ECS, credentials come from the task role (no keys needed).
# For local dev, use a profile or set these:
# AWS_ACCESS_KEY_ID=REPLACE_ME
# AWS_SECRET_ACCESS_KEY=REPLACE_ME

# ── Bedrock model config ──────────────────────────────────────────────────────
# Base URL for OpenAI-compatible Bedrock endpoint (chat/utility LLMs)
# Set this to route OpenAI SDK calls through Bedrock.
# Format: https://bedrock-runtime.<region>.amazonaws.com/model/
BEDROCK_OPENAI_BASE=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1
# Model ID used for all chat tiers when routing through Bedrock
BEDROCK_CHAT_MODEL=openai.gpt-5-6-luna
BEDROCK_API_KEY=REPLACE_ME

# ── AI — keep these for local dev / non-Bedrock fallback ─────────────────────
OPENAI_API_KEY=REPLACE_ME
GEMINI_API_KEY=REPLACE_ME
DEEPSEEK_API_KEY=REPLACE_ME
LLAMA_CLOUD_API_KEY=REPLACE_ME
OPENROUTER_API_KEY=REPLACE_ME
VERTEX_API_KEY=REPLACE_ME

# ── Google OAuth (Drive) ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME
# Must match the redirect URI registered in Google Cloud Console.
# On AWS: use the ALB DNS name, e.g. http://your-alb.us-east-1.elb.amazonaws.com/auth/google/callback
GOOGLE_REDIRECT_URI=REPLACE_ME

# ── YouTube ───────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=REPLACE_ME
YT_DLP_PROXY=REPLACE_ME

# ── Nango (OAuth-as-a-service) ────────────────────────────────────────────────
NANGO_BASE_URL=REPLACE_ME
NANGO_SECRET_KEY=REPLACE_ME

# ── App URLs ──────────────────────────────────────────────────────────────────
# CLIENT_URL: where OAuth callbacks redirect back to after success/failure
CLIENT_URL=REPLACE_ME
# MCP_SERVER_URL: public base URL for per-workspace MCP connector links
# On AWS: http://<ALB_DNS>/mcp
MCP_SERVER_URL=REPLACE_ME
# WORKER_BASE_URL: this service's public base URL (used by Nango callbacks etc.)
# On AWS: http://<ALB_DNS>
WORKER_BASE_URL=REPLACE_ME

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=REPLACE_ME

# ── Cron / sync guard ─────────────────────────────────────────────────────────
CONSOLIDATION_SYNC_KEY=REPLACE_ME

# ── Admin ─────────────────────────────────────────────────────────────────────
POYSIS_ADMIN_USER_IDS=REPLACE_ME
SEED_WORKSPACE_ID=REPLACE_ME
POYSIS_SEED_USER_ID=REPLACE_ME
WORKSPACE_ID=REPLACE_ME

# ── Migration script (local use only) ────────────────────────────────────────
# SUPABASE_DIRECT_CONNECTION_STRING=postgresql://...  # source
# RDS_CONNECTION_STRING=postgresql://...               # target (same as DB_CONNECTION_STRING above)
